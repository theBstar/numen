# Database
# Passwords here must match POSTGRES_PASSWORD and NUMEN_APP_PASSWORD below,
# which docker compose passes to the database container on first start.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/numen
# App role connection (RLS-enforced, non-superuser)
DATABASE_APP_URL=postgresql+asyncpg://numen_app:numen_app_password@localhost:5432/numen

# Used only when the database container initialises its data directory. To
# change them later, change these AND the URLs above, then recreate the
# volume - Postgres ignores them once the cluster exists.
POSTGRES_PASSWORD=password
NUMEN_APP_PASSWORD=numen_app_password

# Redis
REDIS_URL=redis://localhost:6379/0

# FalkorDB (graph database)
FALKORDB_URL=redis://localhost:6381

# Environment: "development" (default) or "production". In production, startup
# refuses to boot if SECRET_KEY, JWT_SECRET_KEY, or ENCRYPTION_KEY are unset /
# default, if ALLOW_HEADER_AUTH is true, or if WEBHOOK_REQUIRED is false.
ENVIRONMENT=development

# App
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Leave SECRET_KEY and JWT_SECRET_KEY empty for local development: strong
# values are generated on first boot and cached in .numen-dev-secrets.json
# so restarts keep you signed in. Both MUST be set explicitly in production,
# where startup refuses to run without them.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
JWT_SECRET_KEY=

# Encryption for OAuth tokens at rest. In dev leave blank to derive from SECRET_KEY.
# In prod this MUST be set and MUST NOT be rotated after first use.
ENCRYPTION_KEY=

# Dev-only: permit X-Member-Email header to stand in for a JWT. Never true in prod.
ALLOW_HEADER_AUTH=false

# Webhook signature verification. Must be true in prod.
WEBHOOK_REQUIRED=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Linear OAuth
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Signing secret for Linear webhook HMAC validation
LINEAR_SIGNING_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# HMAC key for repo webhook signatures. Numen signs and verifies with the same
# value, so leaving it blank works - it falls back to GITHUB_CLIENT_SECRET, then
# SECRET_KEY. Set it explicitly to rotate webhook trust without touching the
# OAuth app, and always set it if you connect GitHub with a PAT.
GITHUB_WEBHOOK_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Jira OAuth (Atlassian Cloud 3LO -- create app at https://developer.atlassian.com/console/myapps/)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Random string used to validate Jira webhook deliveries (we generate this; not from Atlassian).
JIRA_SIGNING_SECRET=

# LLM (suggestions, briefings, chat)
# Numen speaks the OpenAI wire protocol, so any compatible endpoint works:
# OpenAI, Azure OpenAI, OpenRouter, Ollama, vLLM, LiteLLM.
#
#   OpenAI          LLM_API_KEY=sk-...            LLM_BASE_URL=  (leave empty)
#   Ollama (local)  LLM_API_KEY=  (leave empty)   LLM_BASE_URL=http://localhost:11434/v1
#                   LLM_MODEL=llama3.3            EMBEDDING_MODEL=nomic-embed-text
#                   EMBEDDING_DIMENSIONS=768
#   OpenRouter      LLM_API_KEY=sk-or-...         LLM_BASE_URL=https://openrouter.ai/api/v1
#
# With a local endpoint, no data leaves your network.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Changing the embedding model or its width requires reindexing the graph.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Email (Resend)
RESEND_API_KEY=
BRIEFING_FROM_EMAIL=briefings@example.com

# Workers
SYNC_INTERVAL_SECONDS=300
BRIEFING_HOUR_UTC=13

# Who may sign in.
#   open   - any business email joins, or creates, the org for its domain.
#            Suits a hosted product; on your own instance it lets in anyone
#            who shares your email domain. This is the default so existing
#            deployments are unchanged.
#   domain - only ALLOWED_EMAIL_DOMAINS, and only into an org that exists.
#            The usual choice for a single company. Exact match: listing
#            example.com does not admit sub.example.com.
#   invite - nobody joins automatically; members must be added first.
SIGNUP_MODE=open
ALLOWED_EMAIL_DOMAINS=

# Demo orgs hold synthetic data that a daily job keeps looking fresh. Leave
# this off unless you are running a public demo - a normal install has no demo
# org, so the job would only wake every minute to find nothing.
DEMO_MODE=false

# Admin (comma-separated). Set to your own address on first run.
ADMIN_EMAILS=

# MCP
MCP_ENABLED=true

# Frontend
VITE_API_URL=http://localhost:8001
VITE_SHOW_USER_VIEW_SWITCH=true
# Serve the public landing page and blog from this build. Off for self-hosted
# installs, where "/" should go straight to the app rather than to a marketing
# page about a product you are already running.
VITE_MARKETING_SITE=false

# Analytics (platform-agnostic tracking)
# Comma list of providers, e.g. "posthog,console". Defaults to console.
ANALYTICS_PROVIDERS=console
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

VITE_ANALYTICS_PROVIDERS=console
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
